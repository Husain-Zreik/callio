# =============================================================================
# WEBRTC SERVER — ENVIRONMENT TEMPLATE
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to source control — it is in .gitignore.
# .env.example IS committed and must stay in sync with envConfig.js.
# WARNING: Never put real credentials, passwords, or secrets in this file.
# =============================================================================


# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=local
APP_URL=https://your-domain.com

# Firebase service account credentials — own local copy, not shared with
# Laravel. Place the file at storage/firebase/google-services.json (gitignored),
# or override its location entirely with this var.
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/google-services.json


# =============================================================================
# PM2 WORKER FLEET  (read by ecosystem.config.cjs, not the app)
# =============================================================================
NODE_ENV=production
WORKER_COUNT=2
BASE_PORT=3001
WORKER_MEMORY_LIMIT=1G
WORKER_KILL_TIMEOUT=5000
UV_THREADPOOL_SIZE=16


# =============================================================================
# SERVER
# =============================================================================
NODE_HOST=127.0.0.1
# Comma-separated list of allowed CORS origins. Defaults to * (all) when not set.
# In production, set to your webapp domain(s): https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=


# =============================================================================
# DATABASE
# =============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_POOL_LIMIT=10


# =============================================================================
# REDIS
# =============================================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CONNECT_TIMEOUT_MS=5000


# =============================================================================
# AUTHENTICATION
# =============================================================================
# Generate with: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_min_32_chars

# Shared secret validated on every incoming server-to-server call (Laravel's
# webhook forwarding, call-center toggle, chat/order/template/activity push).
# Must match Laravel's .env NODE_INTERNAL_API_KEY value exactly.
# Generate with: openssl rand -base64 48
# Left unset, these routes stay open (logged as a warning) for backward
# compatibility during rollout — set this in every real environment.
INTERNAL_API_KEY=


# =============================================================================
# WHATSAPP / META API
# =============================================================================
WHATSAPP_API_URL=https://graph.facebook.com/v22.0/


# =============================================================================
# WEBRTC — TURN SERVER
# =============================================================================
# Obtain credentials from your TURN provider (e.g. metered.ca, Twilio, Coturn)
TURN_SERVER_URL=your_turn_server_host
TURN_USERNAME=your_turn_username
TURN_CREDENTIAL=your_turn_credential


# =============================================================================
# STORAGE — LOCAL/PUBLIC DISK (Laravel's storage/app)
# =============================================================================
# Only set this if node/ and backend/ are deployed on different hosts/disks,
# or at a non-default relative layout. Leave unset to keep today's
# monorepo-sibling default (node/../../backend/storage/app).
# LARAVEL_STORAGE_ROOT=/absolute/path/to/backend/storage/app


# =============================================================================
# STORAGE — AWS S3
# =============================================================================
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=your_s3_bucket_name
AWS_BUCKET_PREFIX=
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"

S3_RECORDINGS_PREFIX=recordings/
S3_SIGNED_URL_EXPIRY=3600


# =============================================================================
# PUSH NOTIFICATIONS — ONESIGNAL
# =============================================================================
# Found in OneSignal dashboard → App Settings → Keys & IDs
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key


# =============================================================================
# PUSH NOTIFICATIONS — APNs VOIP (ApnsVoipService, MIDLR_APP incoming calls)
# =============================================================================
# Token-based APNs Auth Key (.p8) — one key covers both regular and VoIP
# push. Without APNS_KEY_ID and APNS_TEAM_ID both set, ApnsVoipService's
# provider stays null and every VoIP push silently no-ops — the .p8 file
# alone (see APNS_AUTH_KEY_PATH) is not enough.
# Create at: Apple Developer → Certificates, Identifiers & Profiles → Keys
APNS_KEY_ID=your_apns_key_id
# Apple Developer → Membership details
APNS_TEAM_ID=your_apple_team_id
# Defaults to storage/apple/AuthKey.p8 (gitignored) if unset.
# APNS_AUTH_KEY_PATH=/absolute/path/to/AuthKey.p8
# false = APNs sandbox (Xcode debug builds). true = APNs production, required
# for TestFlight/App Store builds — must match the app's own
# aps-environment entitlement or VoIP tokens registered by the device won't
# be usable by this server.
APNS_PRODUCTION=false


# =============================================================================
# CALL ENGINE
# =============================================================================
MAX_CALLS_PER_WORKER=10
ENCODING_WORKER_COUNT=2
RECORDING_STORAGE_LIMIT_GB=1
ENABLE_NOTIFICATION_LOGS=false
