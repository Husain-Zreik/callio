# =============================================================================
# CALLIO — ENVIRONMENT TEMPLATE
# =============================================================================
# Copy to .env and fill in. .env is gitignored; this file is committed and
# must stay in sync with config/envConfig.js (the only place that reads env).
# Never put real credentials in this file.
# =============================================================================


# =============================================================================
# SECURITY
# =============================================================================
# 32 random bytes, base64. Encrypts secrets stored in the database (channel
# credentials, consumer signing keys, webhook secrets, push credentials).
# Losing it makes those unreadable; rotating it requires re-encrypting them.
# Generate with: openssl rand -base64 32
CALLIO_MASTER_KEY=


# =============================================================================
# PM2 WORKER FLEET  (read by ecosystem.config.cjs, not the app)
# =============================================================================
# PM2 process names are <APP_NAME>_worker_<n> (e.g. dev_worker_1).
APP_NAME=app
NODE_ENV=production
WORKER_COUNT=2
BASE_PORT=3001
WORKER_MEMORY_LIMIT=1G
# ms PM2 waits after SIGINT before SIGKILL. Above the app's own 60 s shutdown
# limit, so recordings finish uploading to S3 on a restart/deploy.
WORKER_KILL_TIMEOUT=65000
UV_THREADPOOL_SIZE=16


# =============================================================================
# SERVER
# =============================================================================
NODE_HOST=127.0.0.1
# Comma-separated CORS origins for agent clients. Defaults to * when unset.
CORS_ALLOWED_ORIGINS=


# =============================================================================
# DATABASE — Callio's own MySQL 8 database (created by `npm run migrate:latest`)
# =============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=callio
DB_USERNAME=callio
DB_PASSWORD=
DB_POOL_LIMIT=10


# =============================================================================
# REDIS — cross-worker state (call ownership, presence, queue order, locks)
# =============================================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CONNECT_TIMEOUT_MS=5000


# =============================================================================
# WHATSAPP CALLING (Meta Cloud API)
# =============================================================================
WHATSAPP_API_URL=https://graph.facebook.com/v22.0/
# Direct Meta ingress (POST /webhooks/whatsapp). Leave unset to accept only
# forwarded webhooks (POST /v1/webhooks/whatsapp/forward, API key).
# App secret: Meta app dashboard → App settings → Basic.
WHATSAPP_APP_SECRET=
# Any string; must match the "Verify token" set in Meta's webhook config.
WHATSAPP_VERIFY_TOKEN=


# =============================================================================
# WEBRTC — STUN / TURN (TURN is needed for agents behind restrictive NATs)
# =============================================================================
# Agents receive these in session:ready; no client ships its own.
# STUN_SERVER_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# A host (turn:<host>:80 udp/tcp + turns:<host>:443 are derived) or a
# comma-separated list of full turn:/turns: URLs.
TURN_SERVER_URL=
# Either a shared secret — short-lived per-agent credentials, coturn's
# use-auth-secret / static-auth-secret — ...
TURN_SECRET=
# TURN_CREDENTIAL_TTL_SECONDS=86400
# ... or one static username/credential pair.
TURN_USERNAME=
TURN_CREDENTIAL=


# =============================================================================
# SIP CHANNEL — the drachtio-server + rtpengine gateway (deploy/sip-gateway)
# =============================================================================
# Unset DRACHTIO_HOST = SIP disabled.
DRACHTIO_HOST=
DRACHTIO_PORT=9022
# Must equal DRACHTIO_SECRET in deploy/sip-gateway/.env.
DRACHTIO_SECRET=
RTPENGINE_HOST=127.0.0.1
RTPENGINE_NG_PORT=22222
# Only when rtpengine has several named interfaces:
# RTPENGINE_CARRIER_INTERFACE=
# RTPENGINE_WEBRTC_INTERFACE=


# =============================================================================
# STORAGE
# =============================================================================
# Recordings and uploaded audio go to S3. Without S3 credentials recording is
# disabled; audio assets can still be registered with storage_provider LOCAL.
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_BUCKET_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Public object base URL, used only when a signed URL can't be generated.
AWS_URL=
S3_RECORDINGS_PREFIX=recordings/
S3_SIGNED_URL_EXPIRY=3600

# Root for audio assets with storage_provider LOCAL. Defaults to ./storage/app.
# STORAGE_LOCAL_ROOT=/var/lib/callio/audio


# =============================================================================
# PUSH NOTIFICATIONS (platform credentials — wake agents' devices)
# =============================================================================
# FCM (Android + iOS alerts): service account JSON. Defaults to
# storage/firebase/google-services.json (gitignored).
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json

# APNs VoIP (iOS CallKit ringing). Needs all three plus the .p8 key file
# (defaults to storage/apple/AuthKey.p8, gitignored).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
# APNS_AUTH_KEY_PATH=/absolute/path/to/AuthKey.p8
# true for TestFlight/App Store builds, false for Xcode debug builds.
APNS_PRODUCTION=false

# OneSignal (web push).
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
# Base URL for relative links in web push notifications.
APP_URL=


# =============================================================================
# CALL ENGINE
# =============================================================================
MAX_CALLS_PER_WORKER=10
ENCODING_WORKER_COUNT=2
# Default recording quota per tenant (tenants.settings.recording overrides).
RECORDING_STORAGE_LIMIT_GB=1
# A live call transferred to an agent who doesn't accept within this many
# seconds goes back to its queue and is offered again (outbound: ends).
CALL_TRANSFER_TIMEOUT_SECONDS=30


# =============================================================================
# LOGGING — src/infra/logging (rules in policy.js; "Logging" in CLAUDE.md)
# =============================================================================
# Records are JSON lines in storage/logs/app/worker-N/YYYY-MM-DD.log, plus
# YYYY-MM-DD.error.log with error and fatal only. Read them with npm run logs
# (--level, --call, --component, --where, --follow, --stats …).
#
# Levels, from most to least detail:
#   trace   per packet / per audio frame (very noisy; short diagnostics only)
#   debug   internal steps: peers, SDP/ICE, tracks, relays, pub/sub, ownership
#   info    lifecycle steps: call offered/answered/ended, leg connected,
#           bridge started/stopped, agent connected, worker started
#   warn    unexpected but handled: refused INVITE, retry, missing config
#   error   failed; someone should look
#   fatal   the worker is going down
#   silent  nothing
# A level includes everything above it: info = info + warn + error + fatal.

# Added to every record so a shared log store (Loki) can tell services and
# servers apart. LOG_ENV empty = NODE_ENV. Examples: development, staging, production.
LOG_SERVICE=callio
LOG_ENV=

# Default level for every component.
#   Development: info    Production: info (warn if volume matters)
LOG_LEVEL=info

# Overrides per component, comma-separated component=level. A component is
# <layer>.<area>.<File>; a prefix covers everything under it, and the
# longest matching prefix wins. Layers: core, channels, media, realtime,
# http, push, outbox, persistence, infra, server. Examples:
#   channels.sip=debug                    all SIP detail
#   media=warn                            quiet media layer
#   media=warn,media.dtmf=debug           quiet media except DTMF
#   http.access=warn                      only failed HTTP requests
#   push.notifications=debug              push diagnostics
# Empty = LOG_LEVEL everywhere. To change levels live on every worker without
# a restart (reverts by itself):  npm run log-level -- channels.sip=debug --for 30m
LOG_LEVELS=

# Also write records to stdout: true | false. Empty = true outside PM2
# (npm run dev), false under PM2 (PM2 discards worker output). Files are
# written either way.
LOG_STDOUT=

# stdout format: pretty (readable, colours in a terminal) | json (one record
# per line, for a log collector). Files are always JSON.
LOG_FORMAT=pretty

# Lowest level shown on stdout; files still keep everything the components
# record. Empty = everything. Example: warn to keep a terminal quiet.
LOG_STDOUT_LEVEL=

# Mask customer phone numbers and SIP users in records: true | false.
# (+96170123999 -> +961*****999). Secrets are always redacted regardless.
#   Development: false   Production: true
LOG_MASK_PII=false

# Days of log files kept per worker; older files are deleted at startup.
LOG_RETENTION_DAYS=14

# Per worker per day, in MB. Past it, only warn and above are written until
# midnight UTC (a notice is logged when that starts). 0 = no cap.
LOG_MAX_DAILY_MB=1024

# Log directory. Empty = storage/logs/app (where npm run logs reads).
LOG_DIR=


# =============================================================================
# METRICS — Prometheus (deploy/observability/README.md)
# =============================================================================
# Bearer token for GET /metrics on each worker; Prometheus reads the same
# value from deploy/observability/prometheus/metrics_token. Empty = /metrics
# is off (404). Generate with: openssl rand -hex 24
METRICS_TOKEN=
