// Callio's logs → Loki (loaded by the shared stack next to base.alloy).
//
// Reads storage/logs/app/worker-*/YYYY-MM-DD.log.
// The .error.log files hold the same error records again and are skipped, so
// nothing arrives twice. Positions survive restarts (the data volume).
//
// Labels (indexed, low-cardinality): service, env, host, level, component.
// Structured metadata (queryable, not indexed): worker and the ids — query
// them with e.g.  {service="callio"} | callId="42"

local.file_match "callio" {
    path_targets = [{
        __path__         = "/var/www/html/callio/storage/logs/app/worker-*/*.log",
        __path_exclude__ = "/var/www/html/callio/storage/logs/app/worker-*/*.error.log",
    }]
    sync_period = "10s"
}

loki.source.file "callio" {
    targets    = local.file_match.callio.targets
    forward_to = [loki.process.callio.receiver]
}

loki.process "callio" {
    stage.json {
        expressions = {
            time           = "time",
            level          = "level",
            service        = "service",
            env            = "env",
            host           = "host",
            component      = "component",
            worker         = "worker",
            callId         = "callId",
            providerCallId = "providerCallId",
            tenantId       = "tenantId",
            agentId        = "agentId",
            requestId      = "requestId",
        }
    }

    stage.timestamp {
        source = "time"
        format = "RFC3339Nano"
    }

    // Everything in these files is Callio's, even records older than the service field.
    stage.static_labels {
        values = { service = "callio" }
    }

    stage.labels {
        values = { service = "", env = "", host = "", level = "", component = "" }
    }

    stage.structured_metadata {
        values = { worker = "", callId = "", providerCallId = "", tenantId = "", agentId = "", requestId = "" }
    }

    forward_to = [loki.write.default.receiver]   // base.alloy
}
