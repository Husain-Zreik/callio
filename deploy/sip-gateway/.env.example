# drachtio-server container environment — copy to .env and fill in real
# values. Separate from Callio's own .env; only used by this deployment.

# The secret drachtio actually uses for its admin connection: the image
# applies DRACHTIO_SECRET over drachtio.conf.xml's <admin secret>. Callio's
# .env DRACHTIO_SECRET must be the same value. After changing it:
#   docker compose up -d --force-recreate drachtio
DRACHTIO_SECRET=CHANGE_ME

# This server's real public IP — same requirement as rtpengine.conf's
# interface setting and the superseded FreeSWITCH milestone's FS_EXTERNAL_IP:
# must be the address the trunk actually sends to, not a private/internal one.
EXTERNAL_IP=CHANGE_ME
