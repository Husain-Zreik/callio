<!--
  drachtio-server config. This process does SIP signaling ONLY — no
  dialplan, no media, no call logic. It listens for SIP (the trunk side)
  and exposes a control connection (admin-tcp) that a drachtio-srf Node app
  connects to, receiving every SIP message as an event and deciding what to
  do entirely in JS.

  The admin secret here is a placeholder, not the one in use: drachtio-server
  takes DRACHTIO_SECRET from its environment (deploy/sip-gateway/.env, via
  docker-compose.yml's env_file), which overrides the secret attribute below.
  Callio's DRACHTIO_SECRET must equal that value. Never commit a real secret
  here. See docs/sip.md.

  Bound to loopback: the Node app connects locally, same-host assumption as
  the rest of this deployment. If Node ends up on a different host, change
  to a private-network address and firewall it — this secret grants full
  control over every SIP call the server handles.

  Confirmed against a real drachtio-server instance (via the local-testing
  variant): the element is <admin> with the bind address as its text
  content, not <admin-tcp address="..."> as first written — a real bug,
  caught by actually running the container, not a hypothetical one.
-->
<drachtio>
  <admin port="9022" secret="CHANGE_ME">127.0.0.1</admin>

  <sip>
    <contacts>
      <!-- Listens for the trunk's SIP traffic. Add ;transport=tls,5061 here
           too if the provider requires SIP/TLS (see docs/sip.md). -->
      <contact>sip:*:5060;transport=udp,tcp</contact>
    </contacts>
  </sip>

  <logging>
    <file>
      <name>/var/log/drachtio/drachtio.log</name>
      <archive>/var/log/drachtio/archive</archive>
      <size>1024</size>
      <maxSize>5000</maxSize>
      <loglevel>info</loglevel>
      <sofia-loglevel>3</sofia-loglevel>
    </file>
  </logging>
</drachtio>
