{
  "name": "callio",
  "version": "0.1.0",
  "description": "Standalone WhatsApp WebRTC call-center service (extracted calls infrastructure)",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "logs": "node scripts/logs.js",
    "logs:follow": "node scripts/logs.js --follow",
    "logs:errors": "node scripts/logs.js --errors"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.990.0",
    "@aws-sdk/lib-storage": "^3.990.0",
    "@aws-sdk/s3-request-presigner": "^3.990.0",
    "@discordjs/opus": "^0.10.0",
    "@parse/node-apn": "^8.1.0",
    "@roamhq/wrtc": "^0.10.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^13.6.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "tar": "^7.5.22"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "whatsapp",
    "webrtc",
    "calling",
    "nodejs"
  ],
