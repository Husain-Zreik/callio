{
  "name": "callio",
  "version": "0.1.0",
  "description": "Standalone call-center service: WhatsApp and SIP calls, queues, IVR, recording — integrated by any product through an API",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "logs": "node scripts/logs.js",
    "logs:follow": "node scripts/logs.js --follow",
    "logs:errors": "node scripts/logs.js --errors",
    "migrate:status": "knex migrate:status",
    "migrate:latest": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:make": "knex migrate:make",
    "test:e2e": "node test/e2e/run.mjs",
    "consumer:create": "node scripts/create-consumer.js",
    "seed:dev": "node scripts/seed-dev.js",
    "sip:trunk": "node scripts/sip-trunk.js",
    "agent:token": "node scripts/agent-token.js",
    "demo:agent": "node sdk/agent-js/examples/serve.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.990.0",
    "@aws-sdk/lib-storage": "^3.990.0",
    "@aws-sdk/s3-request-presigner": "^3.990.0",
    "@discordjs/opus": "^0.10.0",
    "@fastify/cors": "^10.0.0",
    "@parse/node-apn": "^8.1.0",
    "@roamhq/wrtc": "^0.10.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.13.2",
    "dotenv": "^16.6.1",
    "drachtio-srf": "^5.0.29",
    "fastify": "^5.0.0",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^13.6.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "mysql2": "^3.14.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "socket.io-client": "^4.8.1"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "tar": "^7.5.22"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "webrtc",
    "call-center",
    "whatsapp",
    "sip",
    "ivr",
    "contact-center"
  ],
  "author": "HUZK",
  "license": "MIT",
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "@discordjs/opus@0.10.0": true,
    "@firebase/util@1.15.0": true,
    "msgpackr-extract@3.0.4": true,
    "protobufjs@7.6.4": true
  }
}
